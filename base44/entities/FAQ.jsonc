{
  "name": "FAQ",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "\u05e9\u05d0\u05dc\u05d4"
    },
    "answer": {
      "type": "string",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
