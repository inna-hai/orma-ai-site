{
  "name": "Lead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "company": {
      "type": "string",
      "description": "\u05d7\u05d1\u05e8\u05d4"
    },
    "role": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "company_size": {
      "type": "string",
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "200+"
      ],
      "description": "\u05d2\u05d5\u05d3\u05dc \u05d7\u05d1\u05e8\u05d4"
    },
    "challenge_area": {
      "type": "string",
      "enum": [
        "\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4",
        "\u05d1\u05d5\u05d8\u05d9\u05dd \u05d5\u05e9\u05d9\u05e8\u05d5\u05ea",
        "\u05d4\u05d8\u05de\u05e2\u05ea AI",
        "\u05d7\u05d9\u05d1\u05d5\u05e8 \u05de\u05e2\u05e8\u05db\u05d5\u05ea",
        "\u05d4\u05db\u05e9\u05e8\u05d5\u05ea",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05ea\u05d7\u05d5\u05dd \u05d4\u05d0\u05ea\u05d2\u05e8"
    },
    "message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea"
    },
    "utm_source": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8 UTM"
    },
    "utm_medium": {
      "type": "string",
      "description": "\u05de\u05d3\u05d9\u05d5\u05dd UTM"
    },
    "utm_campaign": {
      "type": "string",
      "description": "\u05e7\u05de\u05e4\u05d9\u05d9\u05df UTM"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d7\u05d3\u05e9",
        "\u05e0\u05d5\u05e6\u05e8 \u05e7\u05e9\u05e8",
        "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da",
        "\u05e1\u05d2\u05d5\u05e8-\u05d6\u05db\u05d9\u05d9\u05d4",
        "\u05e1\u05d2\u05d5\u05e8-\u05d4\u05e4\u05e1\u05d3"
      ],
      "default": "\u05d7\u05d3\u05e9",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05dc\u05d9\u05d3"
    },
    "is_enterprise": {
      "type": "boolean",
      "default": false,
      "description": "\u05dc\u05d9\u05d3 Enterprise"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}