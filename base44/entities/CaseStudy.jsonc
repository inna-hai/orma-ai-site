    },
    "slug": {
      "type": "string",
      "description": "Slug \u05dc\u05db\u05ea\u05d5\u05d1\u05ea URL"
    },
    "industry": {
      "type": "string",
      "description": "\u05ea\u05d7\u05d5\u05dd"
    },
