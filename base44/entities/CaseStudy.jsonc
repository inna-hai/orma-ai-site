      "type": "string",
      "description": "\u05d4\u05d0\u05ea\u05d2\u05e8"
    },
    "solution": {
      "type": "string",
      "description": "\u05d4\u05e4\u05ea\u05e8\u05d5\u05df"
    },
    "process": {
      "type": "string",
      "description": "\u05d4\u05ea\u05d4\u05dc\u05d9\u05da"
    },
    "results": {
      "type": "string",
      "description": "\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05db\u05dc\u05d9\u05dd \u05e9\u05e0\u05e2\u05e9\u05d4 \u05d1\u05d4\u05dd \u05e9\u05d9\u05de\u05d5\u05e9"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "\u05de\u05d3\u05d3\u05d9\u05dd \u05d5\u05de\u05e1\u05e4\u05e8\u05d9\u05dd"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u05de\u05d5\u05e6\u05d2 \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05d1\u05d9\u05ea"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "\u05e4\u05d5\u05e8\u05e1\u05dd"
    }
  },
  "required": [
